<body>

<h2>🎛️ Control Panel</h2>

<!-- LIVE -->
<div class="section">
  <h3>🔴 LIVE</h3>
  <button>Show LIVE</button>
  <button>Hide LIVE</button>
</div>

<!-- LOWER THIRD -->
<div class="section">
  <h3>📺 Lower Third</h3>
  <input id="ltTitle" placeholder="Title">
  <input id="ltSub" placeholder="Subtitle">
  <button>Show Lower Third</button>
  <button>Hide Lower Third</button>
</div>

<!-- TICKER -->
<div class="section">
  <h3>📰 Ticker</h3>
  <input id="tickerInput" placeholder="Ticker text">
  <button>Show Ticker</button>
  <button>Hide Ticker</button>
</div>

<!-- MONITOR -->
<div class="section">
  <h3>🎥 Monitor Feed</h3>
  <input id="monitorURL" placeholder="https://vdo.ninja/?view=AKMStream" <button="">Load Monitor
</div>




</body></html>
